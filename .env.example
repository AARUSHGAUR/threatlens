###############################################################################
# ThreatLens - Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in the values you have.
#   cp .env.example .env
#
# SECURITY: `.env` is git-ignored. Never commit real API keys.
# ThreatLens works fully WITHOUT any API keys (Demo Mode) - see README.
###############################################################################

# ---------------------------------------------------------------- Application
NODE_ENV=development
PORT=4000

# Public origin of the web client (used for CORS + cookie behaviour)
CLIENT_ORIGIN=http://localhost:5173

# Comma separated list of extra allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ Database
# Path is relative to the repository root when not absolute.
DATABASE_PATH=data/threatlens.sqlite

# ------------------------------------------------------------------- Security
# Secret used to sign JWT session cookies. CHANGE THIS in any real deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-generate-a-long-random-secret
JWT_EXPIRES_IN=8h

# Seeded demo analyst account (created on first run / `npm run seed`)
SEED_ANALYST_EMAIL=analyst@threatlens.local
SEED_ANALYST_PASSWORD=ThreatLens!2024
SEED_ANALYST_NAME=Demo Analyst

# ------------------------------------------------------------------- Demo mode
# demo  = always use the built-in, clearly-labelled fictional dataset
# live  = use real provider APIs when credentials exist, demo provider otherwise
# auto  = use live providers when at least one API key is configured, otherwise demo
INTELLIGENCE_MODE=auto

# Show the "DEMO DATA" banner in the UI (recommended: true)
SHOW_DEMO_BADGE=true

# ------------------------------------------------------ Threat intel providers
# Every key below is OPTIONAL. Missing keys simply disable that provider, and
# the provider status is surfaced in Settings -> Provider Health.

# VirusTotal  https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB   https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# AlienVault OTX  https://otx.alienvault.com/settings
OTX_API_KEY=

# URLhaus (https://urlhaus.abuse.ch/api/) - no key required, left optional
URLHAUS_ENABLED=true

# GreyNoise Community API  https://docs.greynoise.io/
GREYNOISE_API_KEY=

# Shodan  https://account.shodan.io/
SHODAN_API_KEY=

# ------------------------------------------------- Provider request throttling
# Minimum milliseconds between two calls to the same provider (per process).
# Prevents exhausting the free-tier quota (VT: 4 req/min, AbuseIPDB: 1000/day).
PROVIDER_MIN_INTERVAL_MS=1500

# Global upstream request timeout in milliseconds
PROVIDER_TIMEOUT_MS=12000

# ------------------------------------------------------------ Ingest (MISP/STIX)
# Optional: allow ingesting additional indicators from a MISP instance or a
# local STIX 2.1 bundle so the platform can be demonstrated on "collection".
MISP_URL=
MISP_API_KEY=
STIX_BUNDLE_PATH=
